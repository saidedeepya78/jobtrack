# Copy this file to .env.local and fill in the values from your Supabase project.
# Only the PUBLIC anon (or publishable) key belongs here.
# Never put a service_role or secret key in this file or in frontend code.
#
# Leave the placeholder values as-is to run in localStorage demo mode.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
